{
  "name": "c-visualizer",
  "description": "面向 C 语言初学者的代码执行可视化教学工具",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@uiw/react-codemirror": "^4.25.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tree-sitter-c": "^0.24.1",
    "web-tree-sitter": "^0.27.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
